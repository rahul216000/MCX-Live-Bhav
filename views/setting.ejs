<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6f9;
      margin: 0;
      padding: 0;
      color: #333;
    }
    header {
      background: #5898b7;
      color: white;
      text-align: center;
      padding: 1rem;
      font-size: 1.2rem;
      font-weight: bold;
    }
    .container {
      max-width: 600px;
      margin: 1rem auto;
      padding: 1rem;
    }
    .section {
      background: #ffffff;
      border-radius: 12px;
      padding: 1rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 4px 8px rgba(0,0,0,0.08);
    }
    .section h2 {
      margin-top: 0;
      font-size: 1.1rem;
      color: #2c3e50;
      border-bottom: 2px solid #ececdf;
      padding-bottom: 0.5rem;
    }
    label {
      display: block;
      margin-top: 0.8rem;
      font-weight: bold;
      color: #5898b7;
    }
    input {
      width: 96%;
      padding: 0.6rem;
      margin-top: 0.3rem;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 1rem;
    }
    button {
      background: #5898b7;
      color: #fff;
      border: none;
      padding: 0.8rem 1.2rem;
      border-radius: 8px;
      cursor: pointer;
      font-size: 1rem;
      margin-top: 1rem;
      width: 100%;
    }
    button:hover {
      background: #2c3e50;
    }
    @media(max-width: 600px) {
      .container {
        padding: 0.5rem;
      }
    }
  </style>
</head>
<body>
  <header>⚙️ Settings</header>
  <div class="container">

    <!-- Selling Rates -->
    <div class="section">
      <h2>Selling Rates</h2>
      <label for="goldAdjust">Gold Adjustment</label>
      <input type="number" id="goldAdjust" placeholder="Enter adjustment">
      
      <label for="silverAdjust">Silver Adjustment</label>
      <input type="number" id="silverAdjust" placeholder="Enter adjustment">
    </div>

    <!-- Buying Rates -->
    <div class="section">
      <h2>Buying Rates</h2>
      <label for="goldAdjustBuying">Gold Adjustment</label>
      <input type="number" id="goldAdjustBuying" placeholder="Enter adjustment">

      <label for="silverAdjustBuying">Silver Adjustment</label>
      <input type="number" id="silverAdjustBuying" placeholder="Enter adjustment">
    </div>

    <!-- Supplier Rates -->
    <div class="section">
      <h2>Supplier Rates</h2>
      <label for="goldAdjustSupplier">Gold Adjustment</label>
      <input type="number" id="goldAdjustSupplier" placeholder="Enter adjustment">

      <label for="silverAdjustSupplier">Silver Adjustment</label>
      <input type="number" id="silverAdjustSupplier" placeholder="Enter adjustment">
    </div>

    <button onclick="saveSettings()">💾 Save Settings</button>
  </div>

  <script>
    // Load saved values from localStorage when page loads
    window.onload = function() {
      const keys = [
        "goldAdjust", "silverAdjust",
        "goldAdjustBuying", "silverAdjustBuying",
        "goldAdjustSupplier", "silverAdjustSupplier"
      ];
      keys.forEach(key => {
        if(localStorage.getItem(key)) {
          document.getElementById(key).value = localStorage.getItem(key);
        }
      });
    };

    // Save function
    function saveSettings() {
      const keys = [
        "goldAdjust", "silverAdjust",
        "goldAdjustBuying", "silverAdjustBuying",
        "goldAdjustSupplier", "silverAdjustSupplier"
      ];
      keys.forEach(key => {
        const val = document.getElementById(key).value;
        if(val !== "") {
          localStorage.setItem(key, val);
        }
      });
      alert("✅ Settings saved!");
    }
  </script>
</body>
</html>
